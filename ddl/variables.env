# BigQuery project and dataset variables for Hive-to-BigQuery DDL migration.
# Used by deploy_ddl.py and generate_concat_ddl.sh for ${VAR} substitution.
#
# US-region project (raw, staging, retail datasets)
PROJECT_US=acme-analytics
#
# EU-region project (regional_eu dataset — data residency requirement)
PROJECT_EU=acme-analytics-eu
#
# Dataset names
DATASET_RAW=raw
DATASET_STAGING=staging
DATASET_RETAIL=retail
DATASET_REGIONAL=regional_eu
#
# BigQuery location for EU dataset
LOCATION_EU=EU
